<?xml version="1.0" encoding="UTF-8"?>
<!--
  logback.xml — Main Logback Configuration
  =========================================
  Controls WHERE logs go (appenders) and WHICH levels appear.

  Pattern symbols:
   %d{HH:mm:ss.SSS} → timestamp
   %-5level          → log level (padded to 5 chars)
   %logger{36}       → logger/class name (max 36 chars)
   %msg              → the actual log message
   %n                → newline
-->
<configuration>

    <!-- CONSOLE APPENDER: writes to stdout -->
    <appender name="CONSOLE" class="ch.qos.logback.core.ConsoleAppender">
        <encoder>
            <pattern>%d{HH:mm:ss.SSS} %-5level %logger{36} - %msg%n</pattern>
        </encoder>
    </appender>

    <!-- FILE APPENDER: writes to a rolling log file (daily rotation) -->
    <appender name="FILE" class="ch.qos.logback.core.rolling.RollingFileAppender">
        <file>logs/application.log</file>
        <rollingPolicy class="ch.qos.logback.core.rolling.TimeBasedRollingPolicy">
            <fileNamePattern>logs/application.%d{yyyy-MM-dd}.log</fileNamePattern>
            <maxHistory>7</maxHistory>
        </rollingPolicy>
        <encoder>
            <pattern>%d{yyyy-MM-dd HH:mm:ss.SSS} %-5level %logger{36} - %msg%n</pattern>
        </encoder>
    </appender>

    <!-- Package-specific logger: show ALL levels for our code -->
    <logger name="com.interview" level="TRACE" additivity="false">
        <appender-ref ref="CONSOLE"/>
        <appender-ref ref="FILE"/>
    </logger>

    <!-- Root logger: fallback for all other classes (INFO and above) -->
    <root level="INFO">
        <appender-ref ref="CONSOLE"/>
    </root>

</configuration>
