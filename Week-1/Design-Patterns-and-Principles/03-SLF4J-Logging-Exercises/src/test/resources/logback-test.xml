<?xml version="1.0" encoding="UTF-8"?>
<!-- logback-test.xml — Used during mvn test — shows all log levels -->
<configuration>
    <appender name="CONSOLE" class="ch.qos.logback.core.ConsoleAppender">
        <encoder>
            <pattern>%d{HH:mm:ss.SSS} [TEST] %-5level %logger{30} - %msg%n</pattern>
        </encoder>
    </appender>

    <logger name="com.interview" level="TRACE" additivity="false">
        <appender-ref ref="CONSOLE"/>
    </logger>

    <root level="WARN">
        <appender-ref ref="CONSOLE"/>
    </root>
</configuration>
